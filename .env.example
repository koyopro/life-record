# ローカル開発（docker compose up -d で起動する PostgreSQL）
# ホスト側は 5433 に割り当てている（ローカルの Postgres と衝突しないように）
DATABASE_URL="postgres://datalake:datalake@localhost:5433/datalake"

# 本番（Vercel）では Neon の接続文字列を設定する
# DATABASE_URL="postgres://...@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- 画像の保存先（docs/03-functional-spec.md 3.5） ---
#
# ローカル開発は compose.yaml の MinIO を使う。
# S3_ENDPOINT を設定したときだけ path-style でアクセスする。
S3_BUCKET="datalake-images"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="datalake"
S3_SECRET_ACCESS_KEY="datalake-secret"
S3_ENDPOINT="http://localhost:9000"

# 本番（Vercel）では S3 のバケットと、最小権限の IAM ユーザーを設定する。
# S3_ENDPOINT は設定しない（AWS の既定のエンドポイントを使う）。
# S3_BUCKET="..."
# S3_REGION="ap-northeast-1"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
